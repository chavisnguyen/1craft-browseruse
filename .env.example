# ========================================================
# browseruse Configuration (.env)
# ========================================================

# HTTP/SSE Daemon Port (default: 3025)
# PORT=3025

# Host to bind (default empty: binds dual loopback 127.0.0.1 and [::1])
# HOST=127.0.0.1

# Chrome CDP URL for fallback rod backend (default: http://127.0.0.1:9222)
CHROME_CDP_URL=http://127.0.0.1:9222

# Headless mode when Chrome CDP is not running:
# false: opens real visible Chromium window on your screen
# true: runs hidden in background (default: true)
BROWSER_HEADLESS=false

# Optional custom 64-hex-character auth token for extension hub
# If not set, automatically generated and read from ~/.browseruse/token
# BROWSERUSE_TOKEN=
